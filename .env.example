# ─── Supabase ─────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# ─── Push Notifications (optional) ───────────────────────────
# Generate a VAPID key pair with: npx web-push generate-vapid-keys
# Then add the private key to your Supabase Edge Function secrets
REACT_APP_VAPID_PUBLIC_KEY=your-vapid-public-key-here
